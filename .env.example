# Discord USER token (bukan bot token!)
# Cara dapat: buka Discord di browser -> DevTools (F12) -> tab Network ->
# refresh -> klik request apapun -> lihat header "authorization"
# WARNING: melanggar Discord ToS, pakai dengan risiko sendiri
DISCORD_TOKEN=your_discord_user_token_here

# Telegram bot token dari @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Chat ID tujuan (bisa personal / group). Dapat dari @userinfobot
TELEGRAM_CHAT_ID=123456789

# OPSIONAL: Filter channel Discord yang mau di-mirror (pisah dengan koma)
# Dapat ID channel: aktifkan Developer Mode di Discord -> klik kanan channel -> Copy ID
# Kosongkan = mirror semua channel
# Contoh multi-channel: 1234567890,9876543210,5555555555
DISCORD_CHANNEL_IDS=

# OPSIONAL: Filter server/guild Discord (pisah dengan koma). Hanya dipakai
# kalau DISCORD_CHANNEL_IDS kosong.
DISCORD_GUILD_IDS=

# OPSIONAL: Filter keyword (pisah dengan koma, case-insensitive).
# Cuma pesan yang mengandung salah satu keyword ini yang akan di-mirror.
# Kosongkan = mirror semua pesan (ga ada filter keyword).
# Contoh: airdrop,whitelist,mint,free mint,giveaway
KEYWORDS=

# OPSIONAL: Custom label per channel (biar di Telegram nama channelnya jelas).
# Format: <channel_id>:<label>|<channel_id>:<label>|...
# Pisah antar item dengan `|` (pipe), pisah ID & label dengan `:` (colon).
# Kalau ga ada label, otomatis pake nama channel asli dari Discord.
# Contoh: 1234567890:NFT Talk|9876543210:Airdrop Hunters|5555555555:Alpha Calls
CHANNEL_LABELS=

# OPSIONAL: Kalau true, pesan yang lu kirim sendiri dari akun Discord ini
# juga akan di-mirror. Default: false (anti-loop).
MIRROR_SELF=false

# OPSIONAL: Level logging. Pakai DEBUG buat troubleshoot (lebih verbose).
# Pilihan: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
