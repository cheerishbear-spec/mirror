# Discord USER token (bukan bot token!)
# Cara dapat: buka Discord di browser -> DevTools (F12) -> tab Network ->
# refresh -> klik request apapun -> lihat header "authorization"
# WARNING: melanggar Discord ToS, pakai dengan risiko sendiri
DISCORD_TOKEN=your_discord_user_token_here

# Telegram bot token dari @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Chat ID tujuan (bisa personal / group). Dapat dari @userinfobot
TELEGRAM_CHAT_ID=123456789

# OPSIONAL: Filter channel Discord yang mau di-mirror (pisah dengan koma)
# Dapat ID channel: aktifkan Developer Mode di Discord -> klik kanan channel -> Copy ID
# Kosongkan = mirror semua channel
DISCORD_CHANNEL_IDS=

# OPSIONAL: Filter server/guild Discord (pisah dengan koma). Hanya dipakai
# kalau DISCORD_CHANNEL_IDS kosong.
DISCORD_GUILD_IDS=
